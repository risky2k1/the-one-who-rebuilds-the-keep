{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "customConditions": ["development"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
