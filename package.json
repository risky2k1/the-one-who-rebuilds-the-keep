{
  "name": "keep",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @keep/server dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "lint:deps": "depcruise core apps plugins --config .dependency-cruiser.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.2",
    "dependency-cruiser": "18.7.2",
    "kysely": "0.29.8",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
